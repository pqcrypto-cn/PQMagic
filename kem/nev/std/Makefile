	$(CC) $(CFLAGS) $(INCLUDES) -DPARAMS=7 -DUSE_SHA3 -o $@ $(SOURCES) $(SYMMETRICS) $(TEST_SPEED) $(RANDOM)
speed-nev-1024-3329-sha3: $(HEADERS) $(SOURCES) $(SYMMETRICS) $(TEST_SPEED) $(RANDOM)
	$(CC) $(CFLAGS) $(INCLUDES) -DPARAMS=8 -DUSE_SHA3 -o $@ $(SOURCES) $(SYMMETRICS) $(TEST_SPEED) $(RANDOM)
speed-nev-2048-3329-sha3: $(HEADERS) $(SOURCES) $(SYMMETRICS) $(TEST_SPEED) $(RANDOM)
	$(CC) $(CFLAGS) $(INCLUDES) -DPARAMS=9 -DUSE_SHA3 -o $@ $(SOURCES) $(SYMMETRICS) $(TEST_SPEED) $(RANDOM)
speed-nev-512-769-sha3: $(HEADERS) $(SOURCES) $(SYMMETRICS) $(TEST_SPEED) $(RANDOM)
	$(CC) $(CFLAGS) $(INCLUDES) -DPARAMS=10 -DUSE_SHA3 -o $@ $(SOURCES) $(SYMMETRICS) $(TEST_SPEED) $(RANDOM)
speed-nev-1024-769-sha3: $(HEADERS) $(SOURCES) $(SYMMETRICS) $(TEST_SPEED) $(RANDOM)
	$(CC) $(CFLAGS) $(INCLUDES) -DPARAMS=11 -DUSE_SHA3 -o $@ $(SOURCES) $(SYMMETRICS) $(TEST_SPEED) $(RANDOM)
speed-nev-2048-769-sha3: $(HEADERS) $(SOURCES) $(SYMMETRICS) $(TEST_SPEED) $(RANDOM)
	$(CC) $(CFLAGS) $(INCLUDES) -DPARAMS=12 -DUSE_SHA3 -o $@ $(SOURCES) $(SYMMETRICS) $(TEST_SPEED) $(RANDOM)


PQCgenKAT_kem-nev-512-769-c-iccs: $(KAT_FILES) $(SOURCES) $(SYMMETRICS) $(HEADERS) $(DRANDOM)
	$(CC) $(CFLAGS) $(INCLUDES) -DPARAMS=1 -DUSE_ICCS $(SOURCES) $(SYMMETRICS) $(DRANDOM) $(KAT_FILES) -o $@

